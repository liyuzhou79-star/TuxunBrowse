<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Normal permission (no runtime prompt): lets the app watch
         for connectivity coming back so a page sitting on the load
         error screen can reload itself once (v0.70.0). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only ever requested at runtime when a web page itself asks for
         the camera or microphone (scan pages, web calls); never asked
         on startup or in the background. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- No system backup (v0.217.0 privacy audit): with backup on
         and no exclusion rules, Android's cloud backup and
         device-to-device transfer would carry the app's whole
         state (history, bookmarks, fingerprint profiles, proxy
         book, settings) off the device by default — the opposite
         of what a privacy browser promises. The supported way to
         move data is the app's own backup export, which the user
         triggers by hand and can inspect; it is unaffected. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TuxunBrowse"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|fontScale|locale|layoutDirection|density|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Receive text other apps share (v0.73.0): the app
                 asks the user what to do with it (open / save to
                 the reading list / cancel) and never opens it
                 on its own. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Serves content URIs for files the app itself wrote
             (v0.195.0): the downloads page opens legacy Gecko
             download records that carry a plain file path, and a
             file:// URI cannot leave the app on modern Android.
             The provider only ever mints URIs for the app's own
             download folders (see res/xml/file_paths.xml) and is
             not exported; access is per-intent grants only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
